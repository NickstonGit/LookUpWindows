# Runtime config and recovery state
# settings.json itself plus every sibling it can produce at runtime
# (.bak, .invalid, .park.json, .park.json.lock, .park.json.invalid.*).
# config/settings.example.json is deliberately NOT matched by this rule.
config/settings.json
config/settings.json.*

